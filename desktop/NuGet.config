<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    离线还原配置。

    清空所有内置源（nuget.org 等），只保留本地包目录，
    这样在没有网络的环境里也能 restore / build。
    相对路径按本文件所在的 desktop 目录解析。

    两个源的作用：
      local-feed  —— 仓库内随附的离线包目录（.dotnet-home/local-feed，被 gitignore）
      local-cache —— 本机全局 packages 缓存兜底（%NUGET_PACKAGES%）
  -->
  <packageSources>
    <clear />
    <add key="local-feed" value="..\.dotnet-home\local-feed" />
    <!--
      ★ 兜底源：上面那个 local-feed 是 .gitignore 掉的离线包目录，
        全新克隆 / 清过缓存时它并不存在，此时 restore 会直接
        NU1301「本地源不存在」而**整条构建链挂掉**。

        源顺序不影响解析结果（NuGet 会遍历所有源），所以这里挂上
        本机全局 packages 缓存（已解压布局）作为兜底：
        正常离线构建走 local-feed，没有 local-feed 的机器也能直接 build。
    -->
    <add key="local-cache" value="%NUGET_PACKAGES%" />
  </packageSources>

  <config>
    <!-- 本地文件夹源不需要签名校验，关掉可减少还原时的无谓开销 -->
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>
