<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    离线还原配置。

    清空所有内置源（nuget.org 等），只保留仓库内随附的本地包目录，
    这样在没有网络的环境里也能 restore / build。
    local-feed 的路径相对本文件所在的 desktop 目录解析。

    若要把本机 NuGet 缓存也作为兜底，可额外加：
      <add key="fallback" value="%USERPROFILE%\.nuget\packages" />
    但那是全局 packages 文件夹（已解压布局），仅作最后手段，正常构建用不到。
  -->
  <packageSources>
    <clear />
    <add key="local-feed" value="..\.dotnet-home\local-feed" />
  </packageSources>

  <config>
    <!-- 本地文件夹源不需要签名校验，关掉可减少还原时的无谓开销 -->
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>
