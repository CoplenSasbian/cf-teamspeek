<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CfTeamspeed.Desktop</RootNamespace>
    <AssemblyName>CfTeamspeed.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      平台必须显式指定：WindowsAppSDKSelfContained=true 时，
      Windows App SDK 的 targets 会校验平台，AnyCPU 会直接报
      「requires a supported Windows architecture」。
      这里只列 x64 —— arm64 的运行时包没有随仓库附带（见 NuGet.config 的离线说明）。
    -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>

    <!-- 非打包（unpackaged）自包含部署：不依赖 MSIX，也不需要用户预装 Windows App SDK 运行时 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      自己写入口点（Program.cs）。
      自包含非打包部署必须在最早时刻初始化 WinRT / Windows App SDK，
      XAML 自动生成的 Main 不满足这个要求，会导致进程静默退出。
    -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!--
      ⚠️ 不要关闭 AppxGeneratePriEnabled。

      曾经因为 MakePri.exe 报 0x80070005 而试着关掉它（以为「非打包用不到 PRI」），
      结果：**能编译通过，但应用启动后立刻退出、窗口根本不出现**。
      说明这个 .pri 是 XAML 运行时真正要用的，不是打包才需要。

      正确做法是修 MakePri 的问题（见下面的 MakePriExeFullPath）。
    -->

    <!--
      ★ 强制使用 Windows SDK 自带的 MakePri.exe，而不是 NuGet 包
        (Microsoft.Windows.SDK.BuildTools.MSIX) 里的那个。

      实测：
        · NuGet 包里的 makepri.exe（10.0.26100.4654）
          → 执行 new/dump 一律以 0x80070005（拒绝访问）失败，
            且**不给任何诊断信息**，只有 MSB6006 一句。
            连「索引一个只含 a.txt 的目录」都失败；
            但同目录下的 createconfig 却能正常写文件 —— 说明二进制本身没坏，
            是索引这一步被环境挡住了（原因未查明）。
        · Windows Kits 自带的 makepri.exe
          → 同样输入下 exit=0，正常产出 .pri
            （实测本项目：232 named resources / 17990 candidates）。

      两者版本号相同，行为却不同，所以这里显式指到 SDK 的那个。
      若你的机器没有这个路径，删掉本属性即可回退到默认行为。
    -->
    <MakePriExeFullPath Condition="Exists('C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\makepri.exe')">C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\makepri.exe</MakePriExeFullPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260101001" />

    <!--
      WebView2 用于渲染 Cloudflare Turnstile 的人机验证小组件
      （Turnstile 的 token 只能由真实浏览器引擎执行 Cloudflare 的 JS 得到，
       官方没有 REST 接口也没有原生 SDK，这是唯一实现路径）。

      ★ 刻意【不】在此显式声明 Microsoft.Web.WebView2。
        它是 Microsoft.WindowsAppSDK.WinUI 的传递依赖，本来就会进包。

        显式声明过一次的后果：restore 图变化，把
        Microsoft.Windows.SDK.BuildTools.MSIX 的 PriGen 目标激活了，
        而该目标调用 MakePri.exe 时以 0x80070005（拒绝访问）失败 ——
        整个构建挂掉，且错误只有一句 MSB6006，从报错完全看不出
        跟 WebView2 有关系。移除显式引用后构建恢复正常。

        要锁传递依赖版本，用 CentralPackageTransitivePinning，
        而不是加 PackageReference。
    -->

    <!--
      ============================================================
        RTC 音频链路（语音室本体）
      ============================================================

      SIPSorcery —— 纯 C# 的 WebRTC 实现（BSD-3）。
      选它的理由（2026 年实测过一轮）：
        · 纯托管、无原生依赖 —— 与「自包含 + 非打包」的部署形态契合，
          不会像 libwebrtc 那样带进来几百 MB 原生二进制；
        · 活跃维护，net10.0 已在一等公民列表里；
        · 内置 Opus（通过 Concentus），SFU 场景够用。

      淘汰的选项（都记下来，避免以后重复调研）：
        · Microsoft.WinRTC.libwebrtc.win32 —— 最后更新 2021 年、beta、
          仅 UWP、154MB 静态库，等于死路；
        · Microsoft.MixedReality.WebRTC —— 已进维护状态。

      SIPSorceryMedia.Windows —— 麦克风采集 / 扬声器播放（NAudio 后端）。
      实测它的 lib 目录是 net10.0-windows10.0.17763，与本项目 TFM 精确匹配。
    -->
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
    <PackageReference Include="SIPSorceryMedia.Windows" Version="10.0.16" />

    <!--
      实时降噪（DeepFilterNet3 推理）。
      之前担心的「原生 DLL 体积」其实不是新增负担：
      Windows App SDK 本来就带了 onnxruntime.dll，这个包只是补上托管封装。
    -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <!--
    DeepFilterNet3 模型随构建拷贝到输出目录的 models/。
    文件不进仓库（13MB 二进制、可由 release 再生成），
    本机下载过之后让它跟 bin 一起过去，运行时才找得到。
    缺失时 Dfn3Model.ResolveModelDirectory() 返回 null，
    降噪自动降级到「语音门限」，不会崩。

    ★ 源目录刻意叫 assets/ 而不是 models/：
      Windows 文件名大小写不敏感，`models/` 会与源码目录 `Models/`
      解析成**同一个目录** —— 模型文件会混进 C# 源码旁边，
      而且 `Models/` 下已经在放 ApiModels.cs / ServerProfile.cs。
      换成一个不会撞名的目录名，避免这种「看起来是两处、其实是一处」的坑。
  -->
  <ItemGroup Condition="Exists('assets\denoiser_model.onnx')">
    <None Include="assets\denoiser_model.onnx" CopyToOutputDirectory="PreserveNewest" Link="models\denoiser_model.onnx" />
    <None Include="assets\initial_states.npz" CopyToOutputDirectory="PreserveNewest" Link="models\initial_states.npz" />
    <None Include="assets\meta.json" CopyToOutputDirectory="PreserveNewest" Link="models\meta.json" />
  </ItemGroup>

  <!-- 降噪正确性自检用的样本（官方参考实现的输入/输出） -->
  <ItemGroup Condition="Exists('assets\test-noisy.wav')">
    <None Include="assets\test-noisy.wav" CopyToOutputDirectory="PreserveNewest" Link="models\test-noisy.wav" />
    <None Include="assets\test-reference.wav" CopyToOutputDirectory="PreserveNewest" Link="models\test-reference.wav" />
  </ItemGroup>

</Project>
