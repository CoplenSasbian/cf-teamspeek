<?xml version="1.0" encoding="utf-8"?>
<!--
  应用级资源字典。

  直接把网页端 app/styles.css 的语义化色板搬过来，保证两端视觉一致：
  颜色名沿用 CSS 变量名（app / surface / line / ink / accent / up / warn / down），
  这样读代码时「网页端那个颜色」在这里能一眼对上。

  深浅色用 ThemeDictionaries 切换，跟随系统；无需在每个控件上写两套。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ================= 浅色 ================= -->
        <ResourceDictionary x:Key="Light">

            <!-- 页面底色 -->
            <Color x:Key="AppColor">#F5F7FB</Color>
            <Color x:Key="AppMidColor">#EEF2F9</Color>

            <!-- 表面层级 -->
            <Color x:Key="SurfaceColor">#FFFFFF</Color>
            <Color x:Key="Surface2Color">#F1F5F9</Color>
            <Color x:Key="Surface3Color">#E2E8F0</Color>

            <!-- 描边 -->
            <Color x:Key="LineColor">#E2E8F0</Color>
            <Color x:Key="LineSoftColor">#EEF2F7</Color>

            <!-- 文字 -->
            <Color x:Key="InkColor">#0F172A</Color>
            <Color x:Key="Ink2Color">#475569</Color>
            <Color x:Key="Ink3Color">#94A3B8</Color>

            <!-- 强调 -->
            <Color x:Key="AccentColor">#1F47E6</Color>
            <Color x:Key="AccentHoverColor">#1A37B8</Color>
            <Color x:Key="AccentSoftColor">#EEF4FF</Color>
            <Color x:Key="AccentInkColor">#1A37B8</Color>

            <!-- 状态 -->
            <Color x:Key="UpColor">#10B981</Color>
            <Color x:Key="WarnColor">#F59E0B</Color>
            <Color x:Key="DownColor">#EF4444</Color>
        </ResourceDictionary>

        <!-- ================= 深色 ================= -->
        <ResourceDictionary x:Key="Dark">

            <Color x:Key="AppColor">#0A0F1C</Color>
            <Color x:Key="AppMidColor">#0D1424</Color>

            <Color x:Key="SurfaceColor">#141B2D</Color>
            <Color x:Key="Surface2Color">#1C2438</Color>
            <Color x:Key="Surface3Color">#273049</Color>

            <Color x:Key="LineColor">#262F47</Color>
            <Color x:Key="LineSoftColor">#1E2639</Color>

            <Color x:Key="InkColor">#F1F5F9</Color>
            <Color x:Key="Ink2Color">#A3AEC3</Color>
            <Color x:Key="Ink3Color">#6B7691</Color>

            <Color x:Key="AccentColor">#4D74FF</Color>
            <Color x:Key="AccentHoverColor">#6285FF</Color>
            <Color x:Key="AccentSoftColor">#1B2647</Color>
            <Color x:Key="AccentInkColor">#9DB4FF</Color>

            <Color x:Key="UpColor">#34D399</Color>
            <Color x:Key="WarnColor">#FBBF24</Color>
            <Color x:Key="DownColor">#F87171</Color>
        </ResourceDictionary>

        <!-- ================= 高对比（跟随系统高对比主题，避免文字不可读） ================= -->
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="AppColor">#000000</Color>
            <Color x:Key="AppMidColor">#000000</Color>
            <Color x:Key="SurfaceColor">#000000</Color>
            <Color x:Key="Surface2Color">#1A1A1A</Color>
            <Color x:Key="Surface3Color">#333333</Color>
            <Color x:Key="LineColor">#FFFFFF</Color>
            <Color x:Key="LineSoftColor">#999999</Color>
            <Color x:Key="InkColor">#FFFFFF</Color>
            <Color x:Key="Ink2Color">#FFFFFF</Color>
            <Color x:Key="Ink3Color">#DDDDDD</Color>
            <Color x:Key="AccentColor">#00A2FF</Color>
            <Color x:Key="AccentHoverColor">#33B5FF</Color>
            <Color x:Key="AccentSoftColor">#003A5C</Color>
            <Color x:Key="AccentInkColor">#66C8FF</Color>
            <Color x:Key="UpColor">#00FF00</Color>
            <Color x:Key="WarnColor">#FFFF00</Color>
            <Color x:Key="DownColor">#FF0000</Color>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ============================================================
         画刷：由上面的 Color 派生。
         单独写一遍是因为 XAML 不会自动把 Color 变成 SolidColorBrush。
         ============================================================ -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/Brushes.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
