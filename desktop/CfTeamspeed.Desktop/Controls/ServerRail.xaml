<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ 服务器栏（最左侧一列）—— 桌面端相对网页端多出来的那一栏。

  网页端：一个部署 = 一台服务器，baseUrl 即服务器地址，没有「多服务器」概念，
          所以 KOOK 式的最左竖排图标栏在网页端是多余的（DESIGN.md 10.1 明确省略）。
  桌面端：同时挂多台，每台独立 key / 独立 token / 独立房间，因此必须补回来。

  交互（对齐 KOOK / Discord 的习惯）：
    - 单击图标 = 切换服务器
    - 右键图标 = 上下文菜单（重新登录 / 改名 / 移除 / 复制地址）
    - 底部 +   = 添加服务器
    - 底部 ⚙   = 设置
    - 图标左下角小圆点 = 该服务器的连接状态（在线/掉线/需登录/被封）
    - 图标右下角数字   = 该服务器当前在线人数（>0 时才显示）
-->
<UserControl
    x:Class="CfTeamspeed.Desktop.Controls.ServerRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Width="{StaticResource ServerRailWidth}"
            Background="{ThemeResource SurfaceRailBrush}"
            BorderBrush="{ThemeResource LineSoftBrush}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==================== 服务器图标列表 ==================== -->
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Auto"
                          HorizontalScrollMode="Disabled"
                          Padding="0,10,0,10">
                <StackPanel x:Name="ServerItemsHost"
                            Spacing="6"
                            HorizontalAlignment="Center" />
            </ScrollViewer>

            <!-- ==================== 底部固定区 ==================== -->
            <StackPanel Grid.Row="1"
                        Spacing="6"
                        Padding="0,8,0,12"
                        HorizontalAlignment="Center">

                <Border Height="1"
                        Width="32"
                        Background="{ThemeResource LineBrush}"
                        Margin="0,0,0,4" />

                <!-- 添加服务器 -->
                <Button x:Name="AddServerButton"
                        Width="44" Height="44"
                        CornerRadius="14"
                        Background="{ThemeResource Surface2Brush}"
                        BorderThickness="0"
                        ToolTipService.ToolTip="添加服务器">
                    <FontIcon Glyph="&#xE710;" FontSize="16" Foreground="{ThemeResource UpBrush}" />
                </Button>

                <!-- 设置 -->
                <Button x:Name="SettingsButton"
                        Width="44" Height="44"
                        CornerRadius="14"
                        Background="{ThemeResource Surface2Brush}"
                        BorderThickness="0"
                        ToolTipService.ToolTip="设置">
                    <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource Ink2Brush}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
