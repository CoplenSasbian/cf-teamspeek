<?xml version="1.0" encoding="utf-8"?>
<!--
  ④ 服务器成员栏（对应网页端 MemberRail，240px）。

  在线 = 保持 presence 心跳的人（不论是否在房间）；
  离线 = 已注册但当前没连接（离线名册只对管理员返回）。

  与网页端一致：每行操作收进右键菜单（邀请 / 跟随 / 踢出服务器）。
-->
<UserControl
    x:Class="CfTeamspeed.Desktop.Controls.MemberRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Width="{StaticResource MemberRailWidth}"
            Background="{ThemeResource SurfacePanelBrush}"
            BorderBrush="{ThemeResource LineSoftBrush}"
            BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="{StaticResource HeaderHeight}" Padding="14,0,12,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE716;" FontSize="14"
                              Foreground="{ThemeResource Ink3Brush}" />
                    <TextBlock Text="服务器成员"
                               Style="{StaticResource StrongText}"
                               FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="8,2"
                        CornerRadius="999"
                        Background="{ThemeResource Surface2Brush}">
                    <TextBlock x:Name="OnlineCountText"
                               Text="0"
                               FontSize="11"
                               FontFamily="{StaticResource AppMonoFontFamily}"
                               Foreground="{ThemeResource Ink2Brush}" />
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="8,0,8,12">
                <StackPanel>
                    <TextBlock x:Name="OnlineLabel" Text="在线 — 0"
                               Style="{StaticResource GroupLabelText}" />
                    <StackPanel x:Name="OnlineHost" Spacing="1" />

                    <TextBlock x:Name="EmptyHint"
                               Text="这台服务器暂时没有人"
                               Style="{StaticResource CaptionText}"
                               Margin="8,10,0,0"
                               Visibility="Collapsed" />

                    <TextBlock x:Name="OfflineLabel" Text="离线"
                               Style="{StaticResource GroupLabelText}"
                               Margin="8,14,8,4"
                               Visibility="Collapsed" />
                    <StackPanel x:Name="OfflineHost" Spacing="1" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
