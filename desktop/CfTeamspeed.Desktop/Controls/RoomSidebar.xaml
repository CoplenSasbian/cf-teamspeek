<?xml version="1.0" encoding="utf-8"?>
<!--
  ② 房间列表栏（对应网页端 Sidebar，248px）。

  与网页端一致：
    - 顶部：当前服务器名 +「当前服务器」副标题
    - 中部：房间列表（有人的排前面），展开可见房内成员
    - 下部：语音状态面板（未进房时显示待命态）
    - 底部：自己（头像 / 昵称 / 角色）+ 设置 / 登出

  差异：这里的「服务器名」来自【当前激活的那台】，切换服务器时整栏内容跟着换。
-->
<UserControl
    x:Class="CfTeamspeed.Desktop.Controls.RoomSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Width="{StaticResource SidebarWidth}"
            Background="{ThemeResource SurfaceSidebarBrush}"
            BorderBrush="{ThemeResource LineSoftBrush}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==================== 服务器头 ==================== -->
            <Grid Grid.Row="0" Height="{StaticResource HeaderHeight}" Padding="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="32" Height="32"
                        CornerRadius="10"
                        Background="{ThemeResource AccentBrush}"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE95E;" FontSize="15" Foreground="White" />
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ServerNameText"
                               Text="未选择服务器"
                               Style="{StaticResource StrongText}"
                               FontSize="13" />
                    <TextBlock x:Name="ServerHostText"
                               Text="—"
                               Style="{StaticResource CaptionText}" />
                </StackPanel>

                <Button Grid.Column="2"
                        x:Name="RefreshButton"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="刷新房间列表">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                </Button>
            </Grid>

            <!-- ==================== 房间列表 ==================== -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="8,0,8,8">
                <StackPanel>
                    <Grid Margin="6,8,4,6">
                        <TextBlock Text="房间"
                                   Style="{StaticResource GroupLabelText}"
                                   Margin="2,0,0,0" />
                        <Button x:Name="CreateRoomButton"
                                HorizontalAlignment="Right"
                                Style="{StaticResource IconButtonStyle}"
                                Width="24" Height="24"
                                ToolTipService.ToolTip="新建房间">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- 房间行由代码构建（展开态 / 成员 / 右键菜单的组合用代码更清晰） -->
                    <StackPanel x:Name="RoomListHost" Spacing="2" />

                    <TextBlock x:Name="RoomsEmptyHint"
                               Text="还没有房间"
                               Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== 语音状态面板 ==================== -->
            <Border Grid.Row="2"
                    x:Name="VoicePanel"
                    Margin="8,0,8,8"
                    Padding="12,10"
                    CornerRadius="14"
                    Background="{ThemeResource Surface2Brush}">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock x:Name="VoiceRoomName"
                                   Text="未加入房间"
                                   Style="{StaticResource StrongText}"
                                   FontSize="12" />
                        <TextBlock x:Name="VoiceElapsed"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource CaptionText}"
                                   FontFamily="{StaticResource AppMonoFontFamily}" />
                    </Grid>

                    <!-- 连接状态 -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="VoiceStatusDot"
                                 Width="7" Height="7"
                                 VerticalAlignment="Center"
                                 Fill="{ThemeResource Ink3Brush}" />
                        <TextBlock x:Name="VoiceStatusText"
                                   Text="待命"
                                   Style="{StaticResource CaptionText}" />
                    </StackPanel>

                    <!-- 控制条：静音 / 挂断 -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="MuteButton"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Style="{StaticResource SubtleButtonStyle}"
                                Padding="8,7"
                                IsEnabled="False"
                                ToolTipService.ToolTip="静音 / 取消静音（空格）">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="MuteIcon" Glyph="&#xE720;" FontSize="13" />
                                <TextBlock x:Name="MuteLabel"
                                           Text="静音"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="LeaveButton"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Style="{StaticResource SubtleButtonStyle}"
                                Padding="8,7"
                                IsEnabled="False"
                                ToolTipService.ToolTip="离开房间">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8BB;" FontSize="13" />
                                <TextBlock Text="离开" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== 自己 ==================== -->
            <Grid Grid.Row="3"
                  Padding="12,10"
                  BorderBrush="{ThemeResource LineSoftBrush}"
                  BorderThickness="0,1,0,0"
                  ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="34" Height="34"
                        CornerRadius="17"
                        Background="{ThemeResource AccentSoftBrush}">
                    <TextBlock x:Name="SelfInitial"
                               Text="?"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentInkBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="SelfNickname"
                               Text="未登录"
                               Style="{StaticResource StrongText}"
                               FontSize="13" />
                    <TextBlock x:Name="SelfRole"
                               Text="—"
                               Style="{StaticResource CaptionText}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <Button x:Name="ProfileButton"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="账号设置">
                        <FontIcon Glyph="&#xE713;" FontSize="13" />
                    </Button>
                    <Button x:Name="LogoutButton"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="登出此服务器">
                        <FontIcon Glyph="&#xF3B1;" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
