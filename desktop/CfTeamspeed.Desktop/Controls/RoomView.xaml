<?xml version="1.0" encoding="utf-8"?>
<!--
  ③ 房间内容（中间栏，占据剩余宽度）。

  对应网页端 room.tsx / welcome.tsx 的合并：
    - 未进房：服务器总览（房间卡片网格）
    - 已进房：房间信息 + 成员网格 + 底部文字输入占位
-->
<UserControl
    x:Class="CfTeamspeed.Desktop.Controls.RoomView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 标题栏 ==================== -->
        <Grid Grid.Row="0"
              Height="{StaticResource HeaderHeight}"
              Padding="20,0"
              BorderBrush="{ThemeResource LineSoftBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="RoomTitle"
                           Text="服务器总览"
                           Style="{StaticResource StrongText}"
                           FontSize="14" />
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0">
                    <TextBlock x:Name="RoomSubtitle"
                               Text="选择一台服务器开始"
                               Style="{StaticResource CaptionText}" />
                </StackPanel>
            </StackPanel>

            <Button x:Name="RoomMenuButton"
                    Grid.Column="1"
                    Style="{StaticResource IconButtonStyle}"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="房间操作">
                <FontIcon Glyph="&#xE712;" FontSize="14" />
            </Button>
        </Grid>

        <!-- ==================== 内容 ==================== -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20,18">
            <StackPanel Spacing="14">
                <!-- 提示条（错误 / 降级） -->
                <Border x:Name="NoticeBorder"
                        Visibility="Collapsed"
                        Padding="14,10"
                        CornerRadius="14"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon x:Name="NoticeIcon"
                                  Glyph="&#xE7BA;"
                                  FontSize="14"
                                  VerticalAlignment="Top"
                                  Margin="0,1,0,0" />
                        <TextBlock x:Name="NoticeText"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 未进房：房间卡片网格 -->
                <StackPanel x:Name="OverviewPanel" Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="44" Height="44"
                                CornerRadius="14"
                                Background="{ThemeResource AccentSoftBrush}">
                            <FontIcon Glyph="&#xE95E;" FontSize="19"
                                      Foreground="{ThemeResource AccentInkBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="GreetingText"
                                       Text="欢迎"
                                       Style="{StaticResource StrongText}"
                                       FontSize="17" />
                            <TextBlock x:Name="OverviewHint"
                                       Text="挑一个房间开始语音"
                                       Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </StackPanel>

                    <ItemsControl x:Name="RoomCardsHost">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid ItemWidth="248"
                                                       ItemHeight="112"
                                                       Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock x:Name="NoRoomsHint"
                               Text="还没有房间，点左侧「+」新建一个"
                               Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center"
                               Margin="0,36,0,0"
                               Visibility="Collapsed" />
                </StackPanel>

                <!-- 已进房：成员网格 -->
                <StackPanel x:Name="InRoomPanel" Spacing="14" Visibility="Collapsed">
                    <TextBlock x:Name="MembersHeader"
                               Text="房间里的人"
                               Style="{StaticResource GroupLabelText}"
                               Margin="0" />

                    <ItemsControl x:Name="MemberGridHost">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid ItemWidth="112"
                                                       ItemHeight="132"
                                                       Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 底部输入（占位，与网页端一致） ==================== -->
        <Border Grid.Row="2"
                Padding="20,12"
                BorderBrush="{ThemeResource LineSoftBrush}"
                BorderThickness="0,1,0,0"
                Background="{ThemeResource SurfacePanelBrush}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageInput"
                         Grid.Column="0"
                         Style="{StaticResource AppTextBoxStyle}"
                         PlaceholderText="发送消息…"
                         IsEnabled="False" />

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Style="{StaticResource IconButtonStyle}"
                        Width="38" Height="38"
                        IsEnabled="False"
                        ToolTipService.ToolTip="发送（文字聊天尚未开放）">
                    <FontIcon Glyph="&#xE724;" FontSize="14" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
