<?xml version="1.0" encoding="utf-8"?>
<!--
  主窗口：四栏布局。

  ┌──────┬──────────────┬───────────────────────┬───────────────┐
  │ 服务器 │ 房间列表      │ 房间内容               │ 服务器成员     │
  │ 72px │ 248px        │ *                     │ 240px         │
  └──────┴──────────────┴───────────────────────┴───────────────┘
     ↑
     ★ 这一栏是桌面端与网页端【唯一的结构性差异】。
       网页端一个部署就是一台服务器，所以没有多服务器概念，
       KOOK 式的「最左侧服务器竖排图标」在网页端是多余的；
       桌面端要同时挂多台，因此必须把它补回来。
-->
<Window
    x:Class="CfTeamspeed.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CfTeamspeed.Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackdropBrush}">
        <!-- 全局扩展标题栏：让内容延伸到标题栏，视觉上和网页端一样「整块」 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 标题栏（可拖拽区域） ==================== -->
        <Grid x:Name="TitleBarArea"
              Grid.Row="0"
              Height="44"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">
                <FontIcon Glyph="&#xE95E;" FontSize="14" Foreground="{ThemeResource AccentBrush}" />
                <TextBlock x:Name="TitleText"
                           Text="游戏语音室"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource Ink2Brush}" />
            </StackPanel>

            <!-- 连接状态小徽标：省得用户去猜「到底连上没有」 -->
            <StackPanel x:Name="ConnectionBadge"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.9">
                <Ellipse x:Name="ConnectionDot"
                         Width="7" Height="7"
                         Fill="{ThemeResource Ink3Brush}" />
                <TextBlock x:Name="ConnectionText"
                           Text="未连接"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource Ink3Brush}" />
            </StackPanel>
        </Grid>

        <!-- ==================== 四栏主体 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- ① 服务器栏：多服务器（网页端没有） -->
                <ColumnDefinition Width="Auto" />
                <!-- ② 房间列表 -->
                <ColumnDefinition Width="Auto" />
                <!-- ③ 房间内容 -->
                <ColumnDefinition Width="*" MinWidth="320" />
                <!-- ④ 服务器成员（可收起） -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:ServerRail
                x:Name="ServerRailControl"
                Grid.Column="0" />

            <controls:RoomSidebar
                x:Name="SidebarControl"
                Grid.Column="1" />

            <controls:RoomView
                x:Name="RoomViewControl"
                Grid.Column="2" />

            <controls:MemberRail
                x:Name="MemberRailControl"
                Grid.Column="3" />
        </Grid>

        <!--
          空状态：一台服务器都没有时盖住整个界面。
          这时四栏都没意义，直接把「添加服务器」摆在正中间。
        -->
        <Grid x:Name="EmptyStateOverlay"
              Grid.Row="1"
              Background="{ThemeResource AppBackdropBrush}"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14"
                        MaxWidth="420">
                <FontIcon Glyph="&#xE95E;"
                          FontSize="40"
                          Foreground="{ThemeResource AccentBrush}" />
                <TextBlock Text="还没有添加服务器"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource InkBrush}" />
                <TextBlock Text="桌面端可以同时挂多台服务器，各自独立登录。&#x0a;先添加一台，地址就是网页端打开时用的那个网址。"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource Ink3Brush}" />
                <Button x:Name="AddFirstServerButton"
                        Content="添加服务器"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <!-- 轻提示（右下角浮层） -->
        <ItemsControl x:Name="ToastHost"
                      Grid.Row="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,24"
                      IsHitTestVisible="False" />
    </Grid>
</Window>
