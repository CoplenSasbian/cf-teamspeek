{
  // ============================================================
  //  cf-teamspeed — Cloudflare Workers 配置
  // ============================================================
  //  需要你填写的只有一处：D1 的 database_id（见下方 d1_databases）
  //  获取方式：wrangler d1 create cf-teamspeed
  //
  //  本文件【可以】提交到 git（database_id 不是敏感值）
  //  所有密钥请放 .dev.vars，不要写在这里
  // ============================================================

  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cf-teamspeed",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // ------------------------------------------------------------
  // 前端静态资源
  // 构建产物目录，请求静态资源不消耗 Workers 请求额度
  // ------------------------------------------------------------
  "assets": {
    "directory": "./build/client"
  },

  // ------------------------------------------------------------
  // 定时任务：把 DO 内存缓冲批量落库到 D1
  // 每 10 分钟一次 → 每天 144 次触发，D1 写入行数完全可控
  // ------------------------------------------------------------
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  // ------------------------------------------------------------
  // Durable Objects
  // 免费版只支持 SQLite 后端，所以 migrations 必须用 new_sqlite_classes
  // ------------------------------------------------------------
  "durable_objects": {
    "bindings": [
      { "name": "ROOM_DO", "class_name": "RoomDO" },
      { "name": "REGISTRY_DO", "class_name": "RegistryDO" },
      { "name": "ADMIN_DO", "class_name": "AdminDO" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDO", "RegistryDO", "AdminDO"]
    }
  ],

  // ------------------------------------------------------------
  // D1 数据库
  // ⚠️ 需要你填写：把下面的 database_id 换成真实值
  //
  //    获取方法：
  //      wrangler d1 create cf-teamspeed
  //
  //    命令会输出一段配置，复制其中的 database_id 填到下面
  // ------------------------------------------------------------
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-teamspeed",
      "database_id": "ea808fe4-74e0-43d6-89ce-b86cd3d768fb"
    }
  ],

  // ------------------------------------------------------------
  // 非敏感环境变量
  // 密钥（App Secret / 各种 KEY）一律不写在这里，放 .dev.vars
  // ------------------------------------------------------------
  "vars": {
    // Turnstile Site Key —— 这个是公开值，可以进 git
    //
    // 开发阶段：用官方测试 key（总是通过），连 widget 都不用建
    //           1x00000000000000000000AA
    //           对应 .dev.vars 的 TURNSTILE_SECRET_KEY 填
    //           1x0000000000000000000000000000000AA
    //
    // 部署前：换成真实 widget 的 sitekey
    //   获取：https://dash.cloudflare.com/?to=%2F%3Aaccount%2Fturnstile
    //   创建 widget 时 Hostname 填你的域名（白名单，非所有权声明）
    //   随时可改，不阻塞开发
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",

    // 管理员后台路径
    "ADMIN_PATH": "/dev",

    // 应用名称
    "APP_NAME": "游戏语音室",

    // 单个房间默认人数上限
    "MAX_ROOM_MEMBERS": "10",

    // 是否开启端到端加密
    "E2EE_ENABLED": "true",

    // 浏览器不支持 E2EE 时是否降级继续
    "E2EE_FALLBACK": "true",

    // Opus 音频码率（kbps）
    "AUDIO_BITRATE_KBPS": "32",

    // 用量聚合写入窗口（分钟）
    // 免费版 D1 每天仅 10 万行写入，不要调到 1 以下
    "USAGE_FLUSH_INTERVAL_MINUTES": "10",

    // 审计流水保留天数
    "AUDIT_RETENTION_DAYS": "90"
  },

  // ------------------------------------------------------------
  // 可观测性
  // 免费版可用；日志有每日条数上限
  // ------------------------------------------------------------
  "observability": {
    "enabled": true
  },

  // ------------------------------------------------------------
  // 开发环境
  // 本地开发端口，默认 5173（Vite）
  // ------------------------------------------------------------
  "dev": {
    "port": 5173
  }
}
