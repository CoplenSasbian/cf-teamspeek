{
  // ============================================================
  //  cf-teamspeed — Cloudflare Workers 配置【模板】
  // ============================================================
  //  用法：复制本文件为 wrangler.jsonc，再把下面三处占位符换成真实值。
  //
  //  ⚠️ 为什么不直接提交 wrangler.jsonc：
  //     它含账号相关的事实（域名、D1 database_id、Turnstile site key）。
  //     虽然不是密钥（拿到也无法访问数据），但属于部署环境信息，
  //     留在本机、不随仓库分发。见 .gitignore。
  //
  //  需要替换的占位符（共 3 处，都在下面标了 👉）：
  //    1. routes[].pattern            —— 你的自定义域名
  //    2. d1_databases[].database_id  —— wrangler d1 create 的输出
  //    3. vars.TURNSTILE_SITE_KEY     —— Turnstile widget 的 Site Key
  // ============================================================

  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cf-teamspeed",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // ------------------------------------------------------------
  // 前端静态资源
  // 构建产物目录，请求静态资源不消耗 Workers 请求额度
  // ------------------------------------------------------------
  "assets": {
    "directory": "./build/client"
  },

  // ------------------------------------------------------------
  // 自定义域
  // 👉 换成你的域名；不需要自定义域就整个删掉这一节（用 workers.dev）
  // ------------------------------------------------------------
  "routes": [
    {
      "pattern": "voice.example.com",
      "custom_domain": true
    }
  ],

  // ------------------------------------------------------------
  // 定时任务：把 DO 内存缓冲批量落库到 D1
  // 每 10 分钟一次 → 每天 144 次触发，D1 写入行数完全可控
  // ------------------------------------------------------------
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  // ------------------------------------------------------------
  // Durable Objects
  // 免费版只支持 SQLite 后端，所以 migrations 必须用 new_sqlite_classes
  // ------------------------------------------------------------
  "durable_objects": {
    "bindings": [
      { "name": "ROOM_DO", "class_name": "RoomDO" },
      { "name": "REGISTRY_DO", "class_name": "RegistryDO" },
      { "name": "ADMIN_DO", "class_name": "AdminDO" },
      { "name": "PRESENCE_DO", "class_name": "PresenceDO" }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDO", "RegistryDO", "AdminDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PresenceDO"]
    }
  ],

  // ------------------------------------------------------------
  // D1 数据库
  // 👉 database_id 换成真实的（wrangler d1 create cf-teamspeed 的输出）
  // ------------------------------------------------------------
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-teamspeed",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],

  // ------------------------------------------------------------
  // 非敏感环境变量
  // 密钥（App Secret / 各种 KEY）一律不写在这里，放 .dev.vars
  // ------------------------------------------------------------
  "vars": {
    // 👉 Turnstile Site Key
    //    生产：Dashboard → Turnstile → 建 widget（Hostname 填你的域名）
    //    本地开发：可用官方测试 key 1x00000000000000000000AA（总是通过）
    //    对应的 TURNSTILE_SECRET_KEY 走 wrangler secret，不写在这里
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",

    // 管理员后台路径
    "ADMIN_PATH": "/dev",

    // 应用名称
    "APP_NAME": "游戏语音室",

    // 单个房间默认人数上限
    "MAX_ROOM_MEMBERS": "10",

    // 是否开启端到端加密
    "E2EE_ENABLED": "true",

    // 浏览器不支持 E2EE 时是否降级继续
    "E2EE_FALLBACK": "true",

    // Opus 音频码率（kbps）
    "AUDIO_BITRATE_KBPS": "32",

    // 用量聚合写入窗口（分钟）
    // 免费版 D1 每天仅 10 万行写入，不要调到 1 以下
    "USAGE_FLUSH_INTERVAL_MINUTES": "10",

    // 审计流水保留天数
    "AUDIT_RETENTION_DAYS": "90"
  },

  // ------------------------------------------------------------
  // 可观测性
  // 免费版可用；日志有每日条数上限
  // ------------------------------------------------------------
  "observability": {
    "enabled": true
  },

  // ------------------------------------------------------------
  // 开发环境
  // 本地开发端口，默认 5173（Vite）
  // ------------------------------------------------------------
  "dev": {
    "port": 5173
  }
}
