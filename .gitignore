# ============================================================
# 依赖与构建产物
# ============================================================
node_modules/
build/
dist/
.vite/
.turbo/
*.tsbuildinfo

# ============================================================
# 敏感配置 —— 绝对不要提交这些文件
# ============================================================
# 本地环境变量（含所有密钥）
.dev.vars
.dev.vars.*
!.dev.vars.example

# 通用 dotenv
.env
.env.*
!.env.example

# 实际使用的配置文件（模板 config.example.yml 可提交）
config.yml
config.local.yml

# Cloudflare 账户级 API Token（仅用量看板可选功能使用）
.secrets/

# 部署实录（含账号 ID / D1 ID / 资源名等环境事实，只在本机留存，手动同步到其它电脑）
DEPLOY.md
DEPLOY.local.md

# 实际使用的 Wrangler 配置（含域名 / D1 database_id / Turnstile Site Key）
# 仓库里只提交 wrangler.example.jsonc 模板，复制改名后填真实值
wrangler.jsonc

# ============================================================
# Wrangler
# ============================================================
.wrangler/
worker-configuration.d.ts

# ============================================================
# React Router 生成的类型
# ============================================================
.react-router/

# ============================================================
# 编辑器与系统
# ============================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# 日志与临时文件
# ============================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
tmp/
temp/
.tmp-shots/

# ============================================================
# AI 助手工作区（含本地记忆，不入库）
# ============================================================
.workbuddy-ai/
.codebuddy/

# ============================================================
# 测试与覆盖率
# ============================================================
coverage/
.nyc_output/

# ============================================================
# 语音隔离评测台的产物
#   samples/ 合成样本  models/ 模型权重  都可由脚本重建
#   out/     处理结果与试听文件
#   real/    你录的真实音频（个人数据，绝不入库）
# 保留 README.md 与 *.py
# ============================================================
scripts/audio-eval/samples/
scripts/audio-eval/samples_real/
scripts/audio-eval/out/
scripts/audio-eval/out_real/
scripts/audio-eval/models/
scripts/audio-eval/real/
# real/ 里的录音不入库，但那份「怎么录、录完怎么用」的说明要入库
!scripts/audio-eval/real/README.md
scripts/audio-eval/js_states.json
scripts/audio-eval/py_states.json
scripts/audio-eval/*_err.txt
__pycache__/
*.pyc

# ============================================================
# DFN3 前端资产（由 python tools/prepare_web_assets.py 生成）
#   ~24.5MB：ORT 运行时 11MB + 模型 12.9MB + 初始状态
#   脚本化重建，不入库
# 保留 public/_headers
# ============================================================
public/dfn3/denoiser_model.onnx
public/dfn3/initial_states.npz
public/dfn3/ort/